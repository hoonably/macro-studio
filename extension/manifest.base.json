{
  "manifest_version": 3,
  "name": "Macro Studio",
  "version": "1.3.0",
  "description": "작업을 기록하고 나만의 브라우저 매크로를 만들어 실행하세요.",
  "minimum_chrome_version": "135",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "userScripts",
    "alarms"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Macro Studio 열기",
    "default_popup": "ui/popup.html"
  },
  "side_panel": {
    "default_path": "ui/studio.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
