      "world": "MAIN",
      "allFrames": false
    },
    {
      "matches": [
        "https://s4hana.unist.ac.kr/sap/bc/webdynpro/sap/ZHRW3213*",
        "https://s4hana.unist.ac.kr/sap/bc/webdynpro/sap/ZHRW3218*"
      ],
      "files": [
        "core/namespace.js",
        "core/config.js",
        "adapters/sap.js",
        "ui/launcher.js",
        "scripts/examples/unist-travel/preset.js",
        "scripts/examples/unist-travel/inputs.js",
        "scripts/examples/unist-travel/config.js",
        "scripts/examples/unist-travel/fill.js",
        "scripts/examples/unist-travel/approval.js",
        "scripts/examples/unist-travel/bridge.js",
        "scripts/examples/unist-travel/panel.js"
      ],
      "world": "MAIN",
      "allFrames": true
    }
  ]
