        "https://portal.unist.ac.kr/irj/portal*"
      ],
      "files": [
        "core/namespace.js",
        "core/config.js",
        "ui/launcher.js",
        "scripts/examples/unist-travel/preset.js",
        "scripts/examples/unist-travel/inputs.js",
        "scripts/examples/unist-travel/config.js",
        "scripts/examples/unist-travel/navigation.js"
